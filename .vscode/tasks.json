{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build and run webapi",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"run",
				"--project",
				"RMCLoadoutCreator.Webapi"
			],
			"isBackground": true,
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build"
		},
		{
			"label": "build",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/RMCLoadoutCreator.Webapi/RMCLoadoutCreator.WebApi.csproj"
			],
			"problemMatcher": "$msCompile"
		}
	]
}